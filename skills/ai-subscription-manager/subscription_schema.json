{
  "description": "订阅记录字段定义",
  "fields": {
    "sub_id": {
      "type": "string",
      "format": "sub_YYYYMMDD_NNN",
      "description": "唯一ID（自动生成）",
      "required": true,
      "auto": true
    },
    "product_key": {
      "type": "string",
      "description": "关联产品（关联 products.json 的 product_key）",
      "required": true,
      "auto": false
    },
    "tier": {
      "type": "string",
      "description": "订阅的套餐档位（对应 products.json 中 plans 的 tier）",
      "required": true,
      "auto": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "expired"
      ],
      "default": "active",
      "description": "订阅状态",
      "required": true,
      "auto": true
    },
    "start_date": {
      "type": "string",
      "format": "YYYY-MM-DD",
      "description": "订阅开始日期",
      "required": true,
      "auto": false
    },
    "next_billing_date": {
      "type": "string",
      "format": "YYYY-MM-DD",
      "description": "下次扣费日期（自动计算）",
      "required": true,
      "auto": true
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "one-time"
      ],
      "description": "计费周期",
      "required": true,
      "auto": false
    },
    "price_paid": {
      "type": "number",
      "description": "实际支付价格",
      "required": true,
      "auto": false
    },
    "currency": {
      "type": "string",
      "enum": [
        "CNY",
        "USD"
      ],
      "description": "货币单位",
      "required": true,
      "auto": false
    },
    "payment_method": {
      "type": "string",
      "description": "支付方式（如 信用卡、支付宝等）",
      "required": false,
      "auto": false
    },
    "auto_renew": {
      "type": "boolean",
      "default": true,
      "description": "是否自动续费",
      "required": false,
      "auto": false
    },
    "notes": {
      "type": "string",
      "description": "备注",
      "required": false,
      "auto": false
    },
    "created_at": {
      "type": "string",
      "format": "ISO8601",
      "description": "创建时间",
      "required": true,
      "auto": true
    },
    "updated_at": {
      "type": "string",
      "format": "ISO8601",
      "description": "更新时间",
      "required": true,
      "auto": true
    }
  },
  "prepaid_balance_assets": {
    "description": "充值余额型资产（API 余额），存储于 balances.json，与订阅记录分离，由 balance_analyzer.py 管理",
    "storage": "balances.json",
    "fields": {
      "balance_id": {
        "type": "string",
        "format": "bal_YYYYMMDD_HHMMSS",
        "description": "余额资产唯一ID",
        "required": true,
        "auto": true
      },
      "platform": {
        "type": "string",
        "description": "平台名（如 DeepSeek/Kimi/智谱）",
        "required": true,
        "auto": false
      },
      "currency": {
        "type": "string",
        "enum": [
          "CNY",
          "USD"
        ],
        "description": "币种",
        "required": true,
        "auto": false
      },
      "balance": {
        "type": "number",
        "description": "当前余额（随 record/topup 自动增减）",
        "required": true,
        "auto": true
      },
      "topup_amount": {
        "type": "number",
        "description": "累计充值额（低余额预警基准）",
        "required": true,
        "auto": true
      },
      "topup_date": {
        "type": "string",
        "format": "YYYY-MM-DD",
        "description": "最近充值日期",
        "required": true,
        "auto": true
      },
      "purpose": {
        "type": "string",
        "description": "主要用途",
        "required": false,
        "auto": false
      },
      "model_hint": {
        "type": "string",
        "description": "常用模型",
        "required": false,
        "auto": false
      },
      "consumption_log": {
        "type": "array",
        "description": "消耗/充值流水 [{date, amount, type: usage|topup, note}]",
        "required": false,
        "auto": true
      },
      "tokens_used": {
        "type": "string",
        "description": "累计已用 tokens（登记口径， informational）",
        "required": false,
        "auto": false
      }
    }
  }
}